# Copia este archivo a ai-clients/.env (git lo ignora) y ajústalo. No pongas aquí tokens MCP.

# Obligatoria. Clave para firmar las sesiones: una cadena larga y aleatoria.
# Generarla en PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })
EBK_SECURITY_SECRET_KEY=

# IP 100.x.y.z de Tailscale de este PC, para el celular. El puerto 8080 se publica además en 127.0.0.1 (tus CLI).
# Déjalo en 127.0.0.1 si no usas el celular.
EBK_BIND_IP=127.0.0.1

# Nombre o IP con la que abres ezBookkeeping. Se usa en las URL absolutas de las fotos: con localhost, el celular no las verá.
# Por ejemplo, la IP 100.x de Tailscale o su nombre MagicDNS.
EBK_SERVER_DOMAIN=localhost

# Zona horaria del contenedor.
TZ=America/Bogota

# IPs o patrones que pueden usar el MCP (separados por comas; * = cualquier valor en ese octeto).
# Ver el README: con Docker, el servidor puede ver la IP del gateway de Docker en lugar de la del PC.
EBK_MCP_ALLOWED_REMOTE_IPS=127.0.0.1,172.*.*.*,192.168.65.*
